<%= form_with model: [:admin, blog_post], class: "space-y-6" do |f| %>
  <% if blog_post.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-xs text-red-700">
      <h3 class="font-bold mb-1"><%= pluralize(blog_post.errors.count, "error") %> prohibited this post from being saved:</h3>
      <ul class="list-disc list-inside space-y-0.5">
        <% blog_post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-xs font-bold text-slate-700 mb-1" %>
    <%= f.text_field :title, required: true, placeholder: "e.g., How We Scaled Our Infrastructure to 1M Users", class: "w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-hidden transition" %>
  </div>

  <div>
    <%= f.label :status, "Publishing Status", class: "block text-xs font-bold text-slate-700 mb-1" %>
    <%= f.select :status, BlogPost.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full sm:w-48 px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-hidden transition bg-white" %>
  </div>

  <div>
    <%= f.label :body, class: "block text-xs font-bold text-slate-700 mb-1" %>
    <%= f.text_area :body, rows: 14, required: true, placeholder: "Write your article content here...", class: "w-full px-3.5 py-2.5 text-sm font-mono leading-relaxed rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-hidden transition" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to "Cancel", admin_blog_posts_path, class: "px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg transition" %>
    <%= f.submit class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition cursor-pointer" %>
  </div>
<% end %>