<%# app/views/admin/blog_posts/index.html.erb %>
<div class="w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- Header & Top Actions Bar -->
  <div class="bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 text-xs font-semibold text-indigo-700 bg-indigo-50 rounded-full border border-indigo-100">
          Admin Dashboard
        </span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500 font-medium"><%= pluralize(@blog_posts.count, 'Post') %> Total</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Blog Posts</h1>
    </div>

    <!-- Create New Blog Post Button -->
    <%= link_to new_admin_blog_post_path, 
                class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition-all focus:ring-2 focus:ring-indigo-500/20 active:scale-95 shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      New Blog Post
    <% end %>
  </div>

  <!-- Blog Posts Table Card -->
  <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden">
    <% if @blog_posts.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="py-3.5 px-5">Title & Excerpt</th>
              <th scope="col" class="py-3.5 px-4">Status</th>
              <th scope="col" class="py-3.5 px-4">Created Date</th>
              <th scope="col" class="py-3.5 px-5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
            <% @blog_posts.each do |post| %>
              <tr class="hover:bg-slate-50/60 transition group">
                
                <!-- Title & Body Snippet -->
                <td class="py-4 px-5 max-w-md">
                  <div class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition">
                    <%= link_to post.title, edit_admin_blog_post_path(post) %>
                  </div>
                  <p class="text-slate-500 text-[11px] truncate mt-0.5 max-w-sm">
                    <%= truncate(post.content.to_plain_text, length: 90) %>
                  </p>
                </td>

                <!-- Status Badge -->
                <td class="py-4 px-4">
                  <% if post.published? %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 rounded-full border border-emerald-200/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Published
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold text-amber-700 bg-amber-50 rounded-full border border-amber-200/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                      Draft
                    </span>
                  <% end %>
                </td>

                <!-- Date -->
                <td class="py-4 px-4 text-slate-500 text-[11px]">
                  <%= post.created_at.strftime("%b %d, %Y") %>
                </td>

                <!-- Action Controls -->
                <td class="py-4 px-5 text-right">
                  <div class="inline-flex items-center justify-end gap-2">
                    
                    <!-- Toggle Publish Status -->
                    <%= button_to toggle_publish_admin_blog_post_path(post),
                          method: :patch,
                          class: "px-2.5 py-1.5 font-semibold text-[11px] rounded-lg border transition #{post.published? ? 'text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100' : 'text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100'}" do %>
                      <%= post.published? ? 'Unpublish' : 'Publish' %>
                    <% end %>

                    <!-- Edit Button -->
                    <%= link_to edit_admin_blog_post_path(post),
                                class: "px-2.5 py-1.5 font-semibold text-[11px] text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg border border-indigo-200 transition" do %>
                      Edit
                    <% end %>

                    <!-- Public View Link (if published) -->
                    <% if post.published? %>
                      <%= link_to blog_post_path(post),
                                  target: "_blank",
                                  class: "p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition",
                                  title: "View Public Post" do %>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      <% end %>
                    <% end %>

                    <!-- Delete Button -->
                    <%= button_to admin_blog_post_path(post),
                          method: :delete,
                          data: { turbo_confirm: "Are you sure you want to delete '#{post.title}'?" },
                          class: "p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" do %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    <% end %>

                  </div>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="p-12 text-center">
        <div class="w-12 h-12 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-3 text-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-900">No blog posts found</h3>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Write your first post to publish articles and engage your audience.</p>
        <%= link_to "+ Write First Post", new_admin_blog_post_path, class: "mt-4 inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition" %>
      </div>
    <% end %>
  </div>

</div>