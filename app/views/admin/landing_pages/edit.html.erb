<h1>Editing: <%= @landing_page.title %></h1>

<div style="display: flex; gap: 2rem; margin-top: 2rem;">
  <!-- Left side: Live Block Preview List -->
  <div style="flex: 1; border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
    <h3>Page Blocks</h3>
    <div id="page_blocks">
      <% @landing_page.page_blocks.order(:position).each do |block| %>
        <%= render "admin/page_blocks/page_block", page_block: block %>
      <% end %>
    </div>
  </div>

  <!-- Right side: Add New Hero Block Form -->
  <div style="flex: 1; border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
    <h3>Add Hero Block</h3>
    <%= form_with(model: [:admin, @landing_page, @new_block]) do |f| %>
      <%= f.hidden_field :block_type, value: "hero" %>
      
      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Headline</label>
        <%= text_field_tag "page_block[content][headline]", "", required: true, style: "width: 100%; padding: 0.5rem;" %>
      </div>

      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Subheadline</label>
        <%= text_field_tag "page_block[content][subheadline]", "", style: "width: 100%; padding: 0.5rem;" %>
      </div>

      <%= f.submit "Add Block", style: "padding: 0.6rem 1.2rem; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 4px;" %>
    <% end %>
  </div>
</div>