<%# app/views/admin/landing_pages/index.html.erb %>
<div class="w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- Header & Top Actions Bar -->
  <div class="bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 text-xs font-semibold text-indigo-700 bg-indigo-50 rounded-full border border-indigo-100">
          Admin Dashboard
        </span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500 font-medium"><%= pluralize(@landing_pages.count, 'Page') %> Total</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Landing Pages</h1>
    </div>

    <!-- Create New Page Button (Opens Dialog Modal) -->
    <button type="button" 
            onclick="document.getElementById('newLandingPageModal').showModal()"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition-all focus:ring-2 focus:ring-indigo-500/20 active:scale-95 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      Create New Page
    </button>
  </div>

  <!-- Landing Pages Table Card -->
  <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden">
    <% if @landing_pages.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="py-3.5 px-5">Title & Path</th>
              <th scope="col" class="py-3.5 px-4">Status</th>
              <th scope="col" class="py-3.5 px-4">Blocks</th>
              <th scope="col" class="py-3.5 px-4">Last Updated</th>
              <th scope="col" class="py-3.5 px-5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
            <% @landing_pages.each do |page| %>
              <tr class="hover:bg-slate-50/60 transition group">
                
                <!-- Title & Slug -->
                <td class="py-4 px-5">
                  <div class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition">
                    <%= link_to page.title, edit_admin_landing_page_path(page) %>
                  </div>
                  <div class="text-[11px] font-mono text-slate-400 mt-0.5 flex items-center gap-1">
                    <span>/<%= page.slug %></span>
                    <% if page.published? %>
                      <a href="<%= public_landing_page_path(page.slug) %>" target="_blank" class="text-indigo-500 hover:text-indigo-700 hover:underline inline-flex items-center gap-0.5 ml-1">
                        <span>↗ preview</span>
                      </a>
                    <% end %>
                  </div>
                </td>

                <!-- Status Badge -->
                <td class="py-4 px-4">
                  <% if page.published? %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 rounded-full border border-emerald-200/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Published
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold text-amber-700 bg-amber-50 rounded-full border border-amber-200/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                      Draft
                    </span>
                  <% end %>
                </td>

                <!-- Blocks Count -->
                <td class="py-4 px-4">
                  <span class="inline-block px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-600 bg-slate-100 rounded border border-slate-200/60">
                    <%= page.page_blocks.count %> blocks
                  </span>
                </td>

                <!-- Updated At -->
                <td class="py-4 px-4 text-slate-500 text-[11px]">
                  <%= time_ago_in_words(page.updated_at) %> ago
                </td>

                <!-- Action Controls -->
                <td class="py-4 px-5 text-right">
                  <div class="inline-flex items-center justify-end gap-2">
                    
                    <!-- Toggle Publish Status -->
                    <%= button_to toggle_publish_admin_landing_page_path(page),
                          method: :patch,
                          class: "px-2.5 py-1.5 font-semibold text-[11px] rounded-lg border transition #{page.published? ? 'text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100' : 'text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100'}" do %>
                      <%= page.published? ? 'Unpublish' : 'Publish' %>
                    <% end %>

                    <!-- Open Builder / Edit -->
                    <%= link_to edit_admin_landing_page_path(page),
                                class: "px-2.5 py-1.5 font-semibold text-[11px] text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg border border-indigo-200 transition" do %>
                      Builder →
                    <% end %>

                    <!-- Delete Button -->
                    <%= button_to admin_landing_page_path(page),
                          method: :delete,
                          data: { turbo_confirm: "Are you sure you want to delete '#{page.title}'? This action cannot be undone." },
                          class: "p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" do %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    <% end %>

                  </div>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="p-12 text-center">
        <div class="w-12 h-12 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-3 text-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-900">No landing pages found</h3>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Get started by creating your first landing page to build conversion funnels.</p>
        <button type="button" 
                onclick="document.getElementById('newLandingPageModal').showModal()"
                class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition">
          + Create First Page
        </button>
      </div>
    <% end %>
  </div>

</div>

<!-- Modal: Create New Landing Page -->
<dialog id="newLandingPageModal" class="rounded-2xl shadow-2xl p-0 w-full max-w-md backdrop:bg-slate-900/40 backdrop:backdrop-blur-xs border border-slate-200/80">
  <div class="p-6">
    <div class="flex justify-between items-center pb-3 mb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900">Create Landing Page</h3>
        <p class="text-xs text-slate-500 mt-0.5">Enter details to generate a new page builder draft.</p>
      </div>
      <form method="dialog">
        <button class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </form>
    </div>

    <%= form_with model: [:admin, LandingPage.new], class: "space-y-4" do |f| %>
      <div>
        <%= f.label :title, "Page Title", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.text_field :title, 
              required: true, 
              placeholder: "e.g., Summer Sale Campaign", 
              class: "w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-hidden transition" %>
      </div>

      <div>
        <%= f.label :slug, "URL Slug (Optional)", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.text_field :slug, 
              placeholder: "summer-sale (auto-generated if left blank)", 
              class: "w-full px-3 py-2 text-xs font-mono rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-hidden transition" %>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" 
                onclick="document.getElementById('newLandingPageModal').close()"
                class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg transition">
          Cancel
        </button>
        <%= f.submit "Create & Open Builder", 
              class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition cursor-pointer" %>
      </div>
    <% end %>
  </div>
</dialog>