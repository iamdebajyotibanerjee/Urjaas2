<%# app/views/admin/page_blocks/_footer_form.html.erb %>
<% data = page_block.parsed_content %>

<div class="space-y-3">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Copyright Text</label>
    <input type="text" 
           name="page_block[content_data][copyright]" 
           value="<%= data['copyright'] || "© #{Time.current.year} Urjaas. All rights reserved." %>" 
           class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 outline-hidden">
  </div>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="block text-[11px] font-bold text-slate-600 mb-1">Privacy Link</label>
      <input type="text" name="page_block[content_data][privacy_url]" value="<%= data['privacy_url'] || '/privacy' %>" class="w-full px-2.5 py-1.5 text-xs font-mono rounded-md border border-slate-300">
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-600 mb-1">Terms Link</label>
      <input type="text" name="page_block[content_data][terms_url]" value="<%= data['terms_url'] || '/terms' %>" class="w-full px-2.5 py-1.5 text-xs font-mono rounded-md border border-slate-300">
    </div>
  </div>
</div>