<%# app/views/admin/page_blocks/_header_form.html.erb %>
<% data = page_block.parsed_content %>

<div class="space-y-4" data-controller="navigation-editor">
  
  <!-- Brand / Logo Title -->
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Brand Name / Logo Text</label>
    <input type="text" 
           name="page_block[content_data][brand_name]" 
           value="<%= data['brand_name'] || 'Urjaas' %>" 
           class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 outline-hidden">
  </div>

  <!-- Navigation Links Editor -->
  <div class="space-y-2">
    <div class="flex justify-between items-center">
      <label class="block text-xs font-bold text-slate-700">Navigation Links</label>
      <button type="button" 
              data-action="click->navigation-editor#addLink" 
              class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800">+ Add Link</button>
    </div>

    <div data-navigation-editor-target="container" class="space-y-2">
      <% links = data['nav_links'] || [{ 'label' => 'Home', 'url' => '#' }, { 'label' => 'Features', 'url' => '#features' }] %>
      <% links.each_with_index do |link, index| %>
        <div class="flex items-center gap-2 link-row">
          <input type="text" 
                 name="page_block[content_data][nav_links][][label]" 
                 value="<%= link['label'] %>" 
                 placeholder="Label (e.g., Pricing)" 
                 class="w-1/2 px-2.5 py-1.5 text-xs rounded-md border border-slate-300">
          <input type="text" 
                 name="page_block[content_data][nav_links][][url]" 
                 value="<%= link['url'] %>" 
                 placeholder="URL (e.g., /pricing)" 
                 class="w-1/2 px-2.5 py-1.5 text-xs font-mono rounded-md border border-slate-300">
          <button type="button" 
                  data-action="click->navigation-editor#removeLink" 
                  class="text-slate-400 hover:text-red-500 px-1 text-sm font-bold">&times;</button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- CTA Button Option -->
  <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100">
    <div>
      <label class="block text-[11px] font-bold text-slate-600 mb-1">Header Button Label</label>
      <input type="text" 
             name="page_block[content_data][cta_label]" 
             value="<%= data['cta_label'] || 'Get Started' %>" 
             class="w-full px-2.5 py-1.5 text-xs rounded-md border border-slate-300">
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-600 mb-1">Header Button URL</label>
      <input type="text" 
             name="page_block[content_data][cta_url]" 
             value="<%= data['cta_url'] || '#signup' %>" 
             class="w-full px-2.5 py-1.5 text-xs font-mono rounded-md border border-slate-300">
    </div>
  </div>

</div>