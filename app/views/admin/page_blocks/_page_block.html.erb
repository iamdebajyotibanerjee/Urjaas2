<%# app/views/admin/page_blocks/_page_block.html.erb %>
<% data = page_block.parsed_content %>

<div class="border rounded-lg p-4 mb-4 bg-white shadow-sm space-y-4 page-block-item" id="<%= dom_id(page_block) %>" data-block-id="<%= page_block.id %>">
  <%= form_with model: [:admin, page_block.landing_page, page_block], local: false do |f| %>
    <div class="flex justify-between items-center border-b pb-2 mb-3">
      <div class="flex items-center space-x-2">
        <%# Drag Handle Icon %>
        <div class="drag-handle cursor-move text-gray-400 hover:text-gray-600 p-1" title="Drag to reorder">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
            <%= PageBlock::TEMPLATES.dig(page_block.block_type, :name) || page_block.block_type.titleize %>
          </span>
          <p class="text-xs text-gray-400"><%= PageBlock::TEMPLATES.dig(page_block.block_type, :description) %></p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <%= f.submit "Save", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-1.5 rounded cursor-pointer font-medium" %>
        <%= link_to "Delete", admin_landing_page_page_block_path(page_block.landing_page, page_block), 
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, 
                    class: "text-red-600 hover:text-red-800 text-xs font-medium px-2 py-1" %>
      </div>
    </div>

    <div class="space-y-4 text-sm">
      <% case page_block.block_type %>
      <% when "header" %>
        <%= render "admin/page_blocks/forms/header", data: data, f: f %>
      <% when "hero" %>
        <%= render "admin/page_blocks/forms/hero", data: data, f: f %>
      <% when "features" %>
        <%= render "admin/page_blocks/forms/features", data: data, f: f %>
      <% when "products" %>
        <%= render "admin/page_blocks/forms/products", data: data, f: f %>
      <% when "testimonials" %>
        <%= render "admin/page_blocks/forms/testimonials", data: data, f: f %>
      <% when "social_gallery" %>
        <%= render "admin/page_blocks/forms/social_gallery", data: data, f: f %>
      <% when "cta" %>
        <%= render "admin/page_blocks/forms/cta", data: data, f: f %>
      <% when "faq" %>
        <%= render "admin/page_blocks/forms/faq", data: data, f: f %>
      <% when "footer" %>
        <%= render "admin/page_blocks/forms/footer", data: data, f: f %>
      <% else %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Block Data (JSON)</label>
          <%= text_area_tag "page_block[content_json]", JSON.pretty_generate(data), rows: 6, class: "w-full font-mono text-xs border rounded p-2" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>