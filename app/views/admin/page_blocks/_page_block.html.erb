<%# app/views/admin/page_blocks/_page_block.html.erb %>
<div id="page_block_<%= page_block.id %>" class="bg-white rounded-xl border border-slate-200/80 shadow-2xs hover:border-slate-300 transition group">
  <details class="group/details">
    <summary class="p-4 cursor-pointer list-none flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Drag Handle Icon -->
        <span class="drag-handle cursor-grab active:cursor-grabbing text-slate-400 hover:text-slate-600 transition p-1">
          <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
          </svg>
        </span>

        <div>
          <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-indigo-700 bg-indigo-50 rounded border border-indigo-100">
            <%= page_block.block_type %>
          </span>
          <h4 class="text-xs font-bold text-slate-800 mt-1">
            <%= PageBlock::TEMPLATES.dig(page_block.block_type, :name) || page_block.block_type.titleize %>
          </h4>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs text-indigo-600 font-semibold group-open/details:hidden">Edit Block ↓</span>
        <span class="text-xs text-indigo-600 font-semibold hidden group-open/details:inline">Collapse ↑</span>

        <!-- Delete Button -->
        <%= button_to admin_landing_page_page_block_path(page_block.landing_page, page_block),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this block?" },
              class: "text-slate-400 hover:text-red-600 p-1 rounded transition" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    </summary>

    <!-- Expandable Edit Form Drawer -->
    <div class="px-4 pb-4 pt-2 border-t border-slate-100 bg-slate-50/50 rounded-b-xl">
      <%= form_with model: [:admin, page_block.landing_page, page_block], method: :patch, class: "space-y-4" do |f| %>
        <%= render "admin/page_blocks/forms/fields", page_block: page_block %>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-200/60">
          <button type="submit" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shadow-xs transition">
            Save Changes
          </button>
        </div>
      <% end %>
    </div>
  </details>
</div>