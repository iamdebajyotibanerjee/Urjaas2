<%# app/views/admin/page_blocks/_page_block.html.erb %>
<% data = page_block.parsed_content %>

<div class="group relative bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-3" 
     id="page_block_<%= page_block.id %>"
     data-id="<%= page_block.id %>">
  
  <!-- Block Header / Controls -->
  <div class="flex items-center justify-between pb-2 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <!-- Drag Handle (matches handle: '.drag-handle' in sortable_controller.js) -->
      <span class="drag-handle cursor-grab active:cursor-grabbing text-slate-400 hover:text-slate-600 p-1 rounded hover:bg-slate-100 transition">
        <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
        </svg>
      </span>
      <span class="text-xs font-bold text-slate-700 capitalize">
        <%= page_block.block_type.humanize %> Block
      </span>
    </div>

    <!-- Delete Block -->
    <%= button_to admin_landing_page_page_block_path(page_block.landing_page, page_block),
          method: :delete,
          data: { turbo_confirm: "Delete this block?" },
          class: "text-slate-400 hover:text-red-600 p-1 rounded-md transition cursor-pointer" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    <% end %>
  </div>

  <!-- Block Form Editor -->
  <%= form_with model: [:admin, page_block.landing_page, page_block], class: "space-y-4" do |f| %>
    
    <% case page_block.block_type %>
    <% when "header" %>
      <%= render "admin/page_blocks/header_form", f: f, page_block: page_block %>

    <% when "footer" %>
      <%= render "admin/page_blocks/footer_form", f: f, page_block: page_block %>

    <% when "hero" %>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Title</label>
          <input type="text" name="page_block[content_data][title]" value="<%= data['title'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Subtitle</label>
          <textarea name="page_block[content_data][subtitle]" rows="2" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none"><%= data['subtitle'] %></textarea>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">CTA Text</label>
            <input type="text" name="page_block[content_data][cta_text]" value="<%= data['cta_text'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">CTA URL</label>
            <input type="text" name="page_block[content_data][cta_url]" value="<%= data['cta_url'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
        </div>
      </div>

    <% when "cta" %>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Headline</label>
          <input type="text" name="page_block[content_data][headline]" value="<%= data['headline'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Button Text</label>
            <input type="text" name="page_block[content_data][button_text]" value="<%= data['button_text'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Button URL</label>
            <input type="text" name="page_block[content_data][button_url]" value="<%= data['button_url'] %>" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
        </div>
      </div>

    <% else %>
      <!-- Clean JSON Form Editor for Features, Products, Testimonials, Social Gallery, FAQ -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700 mb-1">Block Configuration (JSON)</label>
        <textarea name="page_block[content_json]" rows="6" class="w-full px-3 py-2 text-xs font-mono bg-slate-50 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none leading-relaxed"><%= JSON.pretty_generate(data) %></textarea>
        <p class="text-[11px] text-slate-400">Edit values inside JSON directly to update content and items.</p>
      </div>
    <% end %>

    <div class="flex justify-end pt-2 border-t border-slate-100">
      <%= f.submit "Save Block", class: "px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition cursor-pointer" %>
    </div>
  <% end %>

</div>