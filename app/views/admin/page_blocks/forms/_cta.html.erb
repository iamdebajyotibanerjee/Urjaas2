<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Headline</label>
    <%= text_field_tag "page_block[content_data][headline]", data["headline"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Button Text</label>
      <%= text_field_tag "page_block[content_data][button_text]", data["button_text"], class: "w-full text-xs border rounded p-2" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Button URL</label>
      <%= text_field_tag "page_block[content_data][button_url]", data["button_url"], class: "w-full text-xs border rounded p-2" %>
    </div>
  </div>
</div>