<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Title</label>
    <%= text_field_tag "page_block[content_data][title]", data["title"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>

  <div class="border-t pt-3 mt-3">
    <label class="block text-xs font-semibold text-gray-600 mb-2">Questions & Answers</label>
    <% (data["questions"] || []).each_with_index do |qa, idx| %>
      <div class="bg-gray-50 p-2.5 rounded border mb-2 space-y-2">
        <input type="text" name="page_block[content_data][questions][<%= idx %>][q]" value="<%= qa["q"] %>" placeholder="Question" class="w-full text-xs border rounded p-1.5 font-medium" />
        <textarea name="page_block[content_data][questions][<%= idx %>][a]" rows="2" placeholder="Answer" class="w-full text-xs border rounded p-1.5"><%= qa["a"] %></textarea>
      </div>
    <% end %>
  </div>
</div>