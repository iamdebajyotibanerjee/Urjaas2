<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Heading</label>
    <%= text_field_tag "page_block[content_data][heading]", data["heading"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Subheading</label>
    <%= text_field_tag "page_block[content_data][subheading]", data["subheading"], class: "w-full text-xs border rounded p-2" %>
  </div>

  <div class="border-t pt-3 mt-3">
    <label class="block text-xs font-semibold text-gray-600 mb-2">Feature Items</label>
    <% (data["items"] || []).each_with_index do |item, idx| %>
      <div class="bg-gray-50 p-2.5 rounded border mb-2 space-y-2">
        <input type="text" name="page_block[content_data][items][<%= idx %>][title]" value="<%= item["title"] %>" placeholder="Item Title" class="w-full text-xs border rounded p-1.5 font-medium" />
        <textarea name="page_block[content_data][items][<%= idx %>][description]" rows="2" placeholder="Item Description" class="w-full text-xs border rounded p-1.5"><%= item["description"] %></textarea>
      </div>
    <% end %>
  </div>
</div>