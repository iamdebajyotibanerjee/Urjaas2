<div class="grid grid-cols-2 gap-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Brand Name</label>
    <%= text_field_tag "page_block[content_data][brand_name]", data["brand_name"], class: "w-full text-xs border rounded p-2 focus:ring-1 focus:ring-indigo-500" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">CTA Label</label>
    <%= text_field_tag "page_block[content_data][cta_label]", data["cta_label"], class: "w-full text-xs border rounded p-2" %>
  </div>
  <div class="col-span-2">
    <label class="block text-xs font-medium text-gray-700 mb-1">CTA URL</label>
    <%= text_field_tag "page_block[content_data][cta_url]", data["cta_url"], class: "w-full text-xs border rounded p-2" %>
  </div>
</div>