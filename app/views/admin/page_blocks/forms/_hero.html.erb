<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Title</label>
    <%= text_field_tag "page_block[content_data][title]", data["title"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Subtitle</label>
    <%= text_area_tag "page_block[content_data][subtitle]", data["subtitle"], rows: 2, class: "w-full text-xs border rounded p-2" %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">CTA Text</label>
      <%= text_field_tag "page_block[content_data][cta_text]", data["cta_text"], class: "w-full text-xs border rounded p-2" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">CTA URL</label>
      <%= text_field_tag "page_block[content_data][cta_url]", data["cta_url"], class: "w-full text-xs border rounded p-2" %>
    </div>
  </div>
</div>