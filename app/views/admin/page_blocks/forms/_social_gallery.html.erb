<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Heading</label>
    <%= text_field_tag "page_block[content_data][heading]", data["heading"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Subheading</label>
    <%= text_field_tag "page_block[content_data][subheading]", data["subheading"], class: "w-full text-xs border rounded p-2" %>
  </div>

  <div class="border-t pt-3 mt-3">
    <label class="block text-xs font-semibold text-gray-600 mb-2">Social Posts</label>
    <% (data["items"] || []).each_with_index do |item, idx| %>
      <div class="bg-gray-50 p-2.5 rounded border mb-2 space-y-2">
        <div class="grid grid-cols-3 gap-2">
          <input type="text" name="page_block[content_data][items][<%= idx %>][name]" value="<%= item["name"] %>" placeholder="Name" class="text-xs border rounded p-1.5 font-medium" />
          <input type="text" name="page_block[content_data][items][<%= idx %>][handle]" value="<%= item["handle"] %>" placeholder="@handle" class="text-xs border rounded p-1.5" />
          <input type="text" name="page_block[content_data][items][<%= idx %>][platform]" value="<%= item["platform"] %>" placeholder="Platform" class="text-xs border rounded p-1.5" />
        </div>
        <textarea name="page_block[content_data][items][<%= idx %>][comment]" rows="2" placeholder="Post comment" class="w-full text-xs border rounded p-1.5"><%= item["comment"] %></textarea>
        <div class="grid grid-cols-3 gap-2">
          <input type="text" name="page_block[content_data][items][<%= idx %>][avatar_url]" value="<%= item["avatar_url"] %>" placeholder="Avatar URL" class="text-xs border rounded p-1.5 col-span-2" />
          <input type="text" name="page_block[content_data][items][<%= idx %>][date]" value="<%= item["date"] %>" placeholder="Time ago" class="text-xs border rounded p-1.5" />
        </div>
      </div>
    <% end %>
  </div>
</div>