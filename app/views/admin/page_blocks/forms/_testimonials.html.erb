<div class="space-y-3">
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Heading</label>
    <%= text_field_tag "page_block[content_data][heading]", data["heading"], class: "w-full text-xs border rounded p-2 font-medium" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-1">Subheading</label>
    <%= text_field_tag "page_block[content_data][subheading]", data["subheading"], class: "w-full text-xs border rounded p-2" %>
  </div>

  <div class="border-t pt-3 mt-3">
    <label class="block text-xs font-semibold text-gray-600 mb-2">Testimonial Reviews</label>
    <% (data["items"] || []).each_with_index do |item, idx| %>
      <div class="bg-gray-50 p-2.5 rounded border mb-2 space-y-2">
        <textarea name="page_block[content_data][items][<%= idx %>][quote]" rows="2" placeholder="Quote" class="w-full text-xs border rounded p-1.5"><%= item["quote"] %></textarea>
        <div class="grid grid-cols-2 gap-2">
          <input type="text" name="page_block[content_data][items][<%= idx %>][author]" value="<%= item["author"] %>" placeholder="Author Name" class="text-xs border rounded p-1.5 font-medium" />
          <input type="text" name="page_block[content_data][items][<%= idx %>][role]" value="<%= item["role"] %>" placeholder="Role / Company" class="text-xs border rounded p-1.5" />
        </div>
        <div class="grid grid-cols-3 gap-2">
          <input type="text" name="page_block[content_data][items][<%= idx %>][avatar_url]" value="<%= item["avatar_url"] %>" placeholder="Avatar Image URL" class="text-xs border rounded p-1.5 col-span-2" />
          <input type="number" name="page_block[content_data][items][<%= idx %>][rating]" value="<%= item["rating"] %>" min="1" max="5" placeholder="Rating" class="text-xs border rounded p-1.5" />
        </div>
      </div>
    <% end %>
  </div>
</div>