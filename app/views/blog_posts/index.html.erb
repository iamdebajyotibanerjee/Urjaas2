<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16">

  <!-- Header -->
  <div class="mx-auto mb-10 max-w-3xl space-y-4 border-b border-slate-200/80 pb-8 text-center sm:mb-12 sm:pb-10">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-indigo-600">Ideas worth spending time with</p>
    <h1 class="text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Articles</h1>
    <p class="mx-auto max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">Insights, guides, and thoughts on product updates and web engineering.</p>
  </div>

  <% if @blog_posts.any? %>
    <!-- Stacked Full-Width Blog Post List -->
    <div class="mx-auto max-w-4xl space-y-5">
      <% @blog_posts.each do |post| %>
        <article class="group flex flex-col justify-between gap-5 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-lg sm:flex-row sm:items-start sm:p-8">
          
          <div class="min-w-0 flex-1 space-y-3">
            <!-- Metadata Row -->
            <div class="flex items-center gap-2 text-sm">
              <time datetime="<%= post.created_at.iso8601 %>" class="font-semibold text-indigo-700">
                <%= post.created_at.strftime("%B %d, %Y") %>
              </time>
              <span class="text-slate-300">•</span>
              <span class="text-slate-500 font-medium">
                <%= [(post.content.to_plain_text.split.size / 200.0).ceil, 1].max %> min read
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-2xl font-bold leading-snug tracking-tight text-slate-900 transition group-hover:text-indigo-700 sm:text-3xl">
              <%= link_to post.title, blog_post_path(post) %>
            </h2>

            <!-- Body Excerpt -->
            <p class="line-clamp-3 max-w-[68ch] text-base leading-relaxed text-slate-600 sm:text-lg">
              <%= truncate(post.content.to_plain_text, length: 220) %>
            </p>
          </div>

          <!-- Read Action Button -->
          <div class="sm:self-center shrink-0">
            <%= link_to blog_post_path(post), class: "inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
              <span>Read Article</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            <% end %>
          </div>

        </article>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200/80 p-8 max-w-md mx-auto">
      <p class="text-sm font-semibold text-slate-700">No published articles yet.</p>
      <p class="text-xs text-slate-500 mt-1">Check back soon for new content!</p>
    </div>
  <% end %>

</div>