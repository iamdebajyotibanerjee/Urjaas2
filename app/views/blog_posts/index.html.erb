<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">

  <!-- Header -->
  <div class="text-left space-y-2 border-b border-slate-200/80 pb-6">
    <h1 class="text-center text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Articles</h1>
    <p class="text-center text-slate-600 text-sm sm:text-base">Insights, guides, and thoughts on product updates and web engineering.</p>
  </div>

  <% if @blog_posts.any? %>
    <!-- Stacked Full-Width Blog Post List -->
    <div class="space-y-4">
      <% @blog_posts.each do |post| %>
        <article class="bg-white rounded-xl border border-slate-200/80 p-6 shadow-xs hover:shadow-md hover:border-indigo-200 transition group flex flex-col sm:flex-row sm:items-start justify-between gap-6">
          
          <div class="space-y-2.5 flex-1 min-w-0">
            <!-- Metadata Row -->
            <div class="flex items-center gap-2 text-xs">
              <time class="font-semibold text-indigo-600">
                <%= post.created_at.strftime("%B %d, %Y") %>
              </time>
              <span class="text-slate-300">•</span>
              <span class="text-slate-500 font-medium">
                <%= (post.body.to_s.split.size / 200.0).ceil %> min read
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition leading-snug">
              <%= link_to post.title, blog_post_path(post) %>
            </h2>

            <!-- Body Excerpt -->
            <p class="text-sm text-slate-600 line-clamp-2 leading-relaxed">
              <%= truncate(post.body.to_s, length: 220) %>
            </p>
          </div>

          <!-- Read Action Button -->
          <div class="sm:self-center shrink-0">
            <%= link_to blog_post_path(post), class: "inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-700 font-semibold text-xs rounded-lg border border-slate-200 hover:border-indigo-200 transition" do %>
              <span>Read Article</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            <% end %>
          </div>

        </article>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200/80 p-8 max-w-md mx-auto">
      <p class="text-sm font-semibold text-slate-700">No published articles yet.</p>
      <p class="text-xs text-slate-500 mt-1">Check back soon for new content!</p>
    </div>
  <% end %>

</div>