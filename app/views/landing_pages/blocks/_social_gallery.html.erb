<%# app/views/landing_pages/blocks/_social_gallery.html.erb %>
<section class="py-16 lg:py-24 bg-slate-900 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="px-3 py-1 text-xs font-semibold text-indigo-400 bg-indigo-950/80 rounded-full border border-indigo-800/50 inline-block mb-3">Community Wall</span>
      <h2 class="text-3xl font-extrabold tracking-tight mb-3">
        <%= block.content&.dig("heading") || "Loved Across the Web" %>
      </h2>
      <p class="text-base text-slate-400">
        <%= block.content&.dig("subheading") || "Real feedback shared across social platforms." %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% (block.content&.dig("items") || []).each do |post| %>
        <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-6 flex flex-col justify-between hover:border-slate-600 transition shadow-lg">
          <div>
            <!-- User Header -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <% if post["avatar_url"].present? %>
                  <img src="<%= post["avatar_url"] %>" alt="<%= post["name"] %>" class="w-10 h-10 rounded-full object-cover border border-slate-700" />
                <% else %>
                  <div class="w-10 h-10 rounded-full bg-slate-700 text-indigo-400 font-bold flex items-center justify-center text-xs">
                    <%= post["name"]&.chr || "S" %>
                  </div>
                <% end %>

                <div>
                  <h4 class="text-xs font-bold text-slate-100"><%= post["name"] %></h4>
                  <p class="text-[11px] text-slate-400"><%= post["handle"] %></p>
                </div>
              </div>

              <!-- Platform Badge -->
              <span class="text-[10px] font-medium text-slate-400 bg-slate-700/60 px-2 py-0.5 rounded border border-slate-600/50">
                <%= post["platform"] || "Social" %>
              </span>
            </div>

            <!-- Comment Text -->
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              <%= post["comment"] %>
            </p>
          </div>

          <!-- Timestamp -->
          <div class="pt-3 border-t border-slate-700/50 flex justify-between items-center text-[10px] text-slate-500">
            <span>Posted <%= post["date"] || "Recently" %></span>
            <svg class="h-4 w-4 text-slate-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>