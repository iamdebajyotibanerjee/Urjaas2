<%# app/views/landing_pages/blocks/_testimonials.html.erb %>
<section class="py-16 lg:py-24 bg-white border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
        <%= block.content&.dig("heading") || "Customer Testimonials" %>
      </h2>
      <p class="text-base text-slate-600">
        <%= block.content&.dig("subheading") || "See what teams are achieving with our tools." %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% (block.content&.dig("items") || []).each do |testimonial| %>
        <div class="bg-slate-50/70 border border-slate-200/80 rounded-2xl p-8 flex flex-col justify-between shadow-2xs hover:shadow-xs transition">
          <div>
            <!-- Star Rating -->
            <div class="flex items-center gap-1 text-amber-400 mb-4">
              <% (testimonial["rating"] || 5).to_i.times do %>
                <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              <% end %>
            </div>

            <!-- Quote -->
            <blockquote class="text-slate-700 text-base leading-relaxed italic mb-6">
              "<%= testimonial["quote"] %>"
            </blockquote>
          </div>

          <!-- Author Meta -->
          <div class="flex items-center gap-3.5 pt-4 border-t border-slate-200/60">
            <% if testimonial["avatar_url"].present? %>
              <img src="<%= testimonial["avatar_url"] %>" alt="<%= testimonial["author"] %>" class="w-11 h-11 rounded-full object-cover border border-slate-200" />
            <% else %>
              <div class="w-11 h-11 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">
                <%= testimonial["author"]&.chr || "U" %>
              </div>
            <% end %>
            <div>
              <h4 class="text-sm font-bold text-slate-900"><%= testimonial["author"] %></h4>
              <p class="text-xs text-slate-500"><%= testimonial["role"] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>