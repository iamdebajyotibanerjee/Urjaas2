<% 
  content     = block.parsed_content || {}
  title_alignment = content["title_alignment"] || content["alignment"] || "text-left"
  body_alignment  = content["body_alignment"] || content["alignment"] || "text-left"
  title_size  = content["title_size"] || "text-3xl"
  title_color = content["title_color"] || "#0f172a"
  body_size   = content["body_size"] || "text-base"
  body_color  = content["body_color"] || "#334155"
%>

<section class="py-12 px-4 max-w-4xl mx-auto">
  <% if content["title"].present? %>
    <h2 class="<%= title_size %> <%= title_alignment %> font-bold mb-6" style="color: <%= title_color %>;">
      <%= content["title"] %>
    </h2>
  <% end %>

  <div class="prose max-w-6/10 <%= body_size %> <%= body_alignment %>" style="color: <%= body_color %>;">
    <%= block.rich_content %>
  </div>
</section>